[Unit]
Description=SeeSize user hub
[Service]
WorkingDirectory=%h/seesize
ExecStart=%h/seesize/seesize-hub-linux-amd64 -listen 127.0.0.1:18081 -data %h/seesize/data/seesize.db -admin-token-file %h/seesize/admin.token -retention-days 7
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
[Install]
WantedBy=default.target
